# Скопировать в setup.env и заполнить
STATIC_IP=192.168.1.100
GATEWAY=192.168.1.1
# DNS должен отдавать брокеру MQTT тот же адрес, что и сейчас в локальной сети
DNS=192.168.1.1
# Клиенты стрима через запятую
STREAM_CLIENTS="192.168.1.10, 192.168.1.11"
# Двухбуквенный код страны
WIFI_COUNTRY=NL
TIMEZONE=Europe/Amsterdam
