[Unit]
Description=Camera rotate servo controller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=pi
NoNewPrivileges=yes
EnvironmentFile=/etc/picamera/servo.env
ExecStart=/usr/bin/python3 /home/pi/picamera/servo.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
